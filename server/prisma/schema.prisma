generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique
  password          String
  avatar            String         @default("")
  role              String         @default("user")
  isBlocked         Boolean        @default(false)
  isProfileComplete Boolean        @default(false)
  lastSeen          DateTime       @default(now())
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  profile           Profile?
  savedProfiles     SavedProfile[] @relation("saver")
  savedBy           SavedProfile[] @relation("saved")
  matchesA          Match[]        @relation("matchUserA")
  matchesB          Match[]        @relation("matchUserB")
  initiatedMatches  Match[]        @relation("initiator")
  likedMatches      MatchLike[]
  dislikedMatches   MatchDislike[]
  sentMessages      Message[]      @relation("sender")
  receivedMessages  Message[]      @relation("receiver")
  notifications     Notification[]
  listings          RoomListing[]
}

model Profile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  age             Int?
  gender          String?
  occupation      String?
  bio             String?
  city            String?
  state           String?
  country         String    @default("India")
  budgetMin       Int       @default(0)
  budgetMax       Int       @default(50000)
  smoking         String    @default("no")
  drinking        String    @default("no")
  pets            String    @default("no")
  sleepSchedule   String    @default("flexible")
  cleanliness     Int       @default(3)
  workFromHome    Boolean   @default(false)
  cooking         String    @default("sometimes")
  genderPreference String   @default("any")
  lookingFor      String    @default("both")
  moveInDate      DateTime?
  photos          String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SavedProfile {
  id        Int  @id @default(autoincrement())
  saverId   Int
  savedId   Int
  saver     User @relation("saver", fields: [saverId], references: [id], onDelete: Cascade)
  saved     User @relation("saved", fields: [savedId], references: [id], onDelete: Cascade)

  @@unique([saverId, savedId])
}

model Match {
  id          Int            @id @default(autoincrement())
  userAId     Int
  userBId     Int
  initiatorId Int?
  score       Int            @default(0)
  status      String         @default("pending")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userA       User           @relation("matchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User           @relation("matchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  initiator   User?          @relation("initiator", fields: [initiatorId], references: [id])
  likedBy     MatchLike[]
  dislikedBy  MatchDislike[]

  @@unique([userAId, userBId])
}

model MatchLike {
  id      Int   @id @default(autoincrement())
  matchId Int
  userId  Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model MatchDislike {
  id      Int   @id @default(autoincrement())
  matchId Int
  userId  Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversation   String
  senderId       Int
  receiverId     Int
  content        String
  read           Boolean  @default(false)
  type           String   @default("text")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sender         User     @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User     @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversation])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomListing {
  id               Int      @id @default(autoincrement())
  ownerId          Int
  title            String
  description      String?
  rent             Int
  deposit          Int      @default(0)
  address          String?
  city             String
  state            String?
  pincode          String?
  roomType         String   @default("single")
  furnishing       String   @default("unfurnished")
  amenities        String[]
  photos           String[]
  availableFrom    DateTime?
  genderPreference String   @default("any")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([city, rent])
}
